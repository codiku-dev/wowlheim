     // user must be provided
     MANGOS_ASSERT(user || PrintEntryError("GameObject::Use (without user)"));
 
+    // Wowlheim : pi??ce de construction -> d??molir / r??parer au marteau selon le mode choisi (Valheim)
+    if (user->GetTypeId() == TYPEID_PLAYER && GetEntry() >= 9110000 && GetEntry() < 9120000 &&
+            Wowlheim_OnPieceUse(static_cast<Player*>(user), GetDbGuid()))
+        return;
+
+    // Wowlheim : n??ud de ressource -> outil ??quip?? requis (hache/pic de Wowlheim), usure de l'outil ?? chaque r??colte
+    if (user->GetTypeId() == TYPEID_PLAYER && sBuildingMgr.IsNodeEntry(GetEntry()))
+    {
+        std::string wlErr;
+        Player* wlPlayer = static_cast<Player*>(user);
+        if (!sBuildingMgr.CheckHarvest(wlPlayer, GetEntry(), wlErr))
+        {
+            wlPlayer->GetSession()->SendNotification("%s", wlErr.c_str());
+            return;
+        }
+        sBuildingMgr.ConsumeToolDurability(wlPlayer);
+        // ouverture directe du butin du n??ud (les coffres sans serrure ne s'ouvrent pas d'eux-m??mes dans ce c??ur)
+        if (!m_loot)
+            m_loot = new Loot(wlPlayer, this, LOOT_CORPSE);
+        m_loot->ShowContentTo(wlPlayer);
+        return;
+    }
+
+    // Wowlheim : ramassable de Valheim (Pickable.Interact) -> ?? la main, sans outil ni endurance : l'objet va directement
+    // dans le sac (pas de fen??tre de butin) puis le ramassable dispara??t jusqu'?? sa repousse (m_respawnTimeMinutes)
+    if (user->GetTypeId() == TYPEID_PLAYER && GetEntry() >= 9130000 && GetEntry() < 9140000)
+    {
+        Player* wlPlayer = static_cast<Player*>(user);
+        if (m_lootState != GO_READY)
+            return;
+        if (!m_loot)
+            m_loot = new Loot(wlPlayer, this, LOOT_CORPSE);
+        if (m_loot->AutoStore(wlPlayer))
+            SetLootState(GO_JUST_DEACTIVATED);
+        return;
+    }
+
     // by default spell caster is user
     WorldObject* spellCaster = user;
     uint32 spellId = 0;
