+// Wowlheim : contenu Valheim du serveur principal, que les bots (qui jouent a WoW vanilla) doivent ignorer.
+//  - GameObjects >= 9 000 000 : pieces posees par les joueurs (9110000-9119999), stations (9120000+), ramassables
+//    (9130000-9139999), noeuds de ressources (9101001-9101999) -> ni vus, ni pilles, ni utilises par les bots.
+//  - Creatures 9300000-9300999 : arbres et rochers a abattre / miner (faction 7, NullAI) -> jamais attaques ni pilles.
+//  - Objets >= 9 000 000 : exclus des caches d'equipement / objets aleatoires (RandomItemMgr.cpp) et jamais equipes
+//    (ItemUsageValue::QueryItemUsageForEquip) ; ex. le marteau 9201100 que playercreateinfo_item donne a tout personnage.
+namespace Wowlheim
+{
+    const uint32 FIRST_ITEM_ENTRY = 9000000;
+    const uint32 FIRST_GAMEOBJECT_ENTRY = 9000000;
+    const uint32 FIRST_TREE_CREATURE_ENTRY = 9300000;
+    const uint32 LAST_TREE_CREATURE_ENTRY = 9300999;
+
+    inline bool IsWowlheimItem(uint32 entry) { return entry >= FIRST_ITEM_ENTRY; }
+    inline bool IsWowlheimGameObject(uint32 entry) { return entry >= FIRST_GAMEOBJECT_ENTRY; }
+    inline bool IsWowlheimCreature(uint32 entry) { return entry >= FIRST_TREE_CREATURE_ENTRY && entry <= LAST_TREE_CREATURE_ENTRY; }
+    // Convention de playerbots (TravelMgr) : entree > 0 = creature, entree < 0 = GameObject.
+    inline bool IsWowlheimTravelEntry(int32 entry)
+    {
+        return entry < 0 ? IsWowlheimGameObject(uint32(-entry)) : IsWowlheimCreature(uint32(entry));
+    }
+
+    // Wowlheim : objets Valheim (materiaux, outils, marteau) en sac d'un bot : il les GARDE sans y toucher.
+    // Jamais vendus, detruits, mis aux encheres, echanges, postes, donnes, deposes en banque, utilises ni desenchantes.
+    // Garde-fou central : ItemUsageValue::Calculate renvoie ITEM_USAGE_KEEP (aucune routine automatique ne les
+    // selectionne) ; chaque action qui retire un objet du sac le verifie aussi (commandes chuchotees comprises).
+    inline bool BotMustKeepItem(uint32 entry) { return IsWowlheimItem(entry); }
+    inline bool BotMustKeepItem(Item const* item) { return item && item->GetProto() && BotMustKeepItem(item->GetProto()->ItemId); }
+
+    // Wowlheim : marteau de construction donne a TOUT nouveau personnage par playercreateinfo_item (commun aux joueurs).
+    // Les bots aleatoires (comptes RNDBOT) ne construisent pas : il leur est retire a la connexion et a la
+    // (re)initialisation. Seul cas ou un bot supprime un objet Valheim, limite a cette entree.
+    const uint32 BOT_STARTER_HAMMER_ENTRY = 9201100;
+    inline uint32 RemoveBotStarterHammer(Player* bot)
+    {
+        if (!bot)
+            return 0;
+        uint32 count = bot->GetItemCount(BOT_STARTER_HAMMER_ENTRY, true);
+        if (count)
+            bot->DestroyItemCount(BOT_STARTER_HAMMER_ENTRY, count, true, false, true);
+        return count;
+    }
+
+    // Wowlheim : pour les bots aleatoires (comptes RNDBOT, sRandomPlayerbotMgr.IsRandomBot) le contenu Valheim
+    // N'EXISTE PAS : ils jouent a WoW. Ils ne prennent jamais un objet >= 9 000 000 (butin laisse aux joueurs, jets de
+    // groupe passes, recompense de quete, achat, courrier, echange entrant refuses, generation d'equipement exclue).
+    // Filet de securite : PurgeWowlheimItems retire silencieusement tout objet Valheim de leur inventaire (sacs, banque,
+    // equipement), appele a la connexion, a la (re)initialisation et toutes les 30 s dans PlayerbotAI::UpdateAI.
+    // Les autres bots (alts de joueurs) gardent le comportement BotMustKeepItem ci-dessus.
+    // Definitions : PlayerbotAI.cpp.
+    bool BotRefusesWowlheimItems(Player* bot);
+    inline bool BotRefusesWowlheimItem(Player* bot, uint32 entry) { return IsWowlheimItem(entry) && BotRefusesWowlheimItems(bot); }
+    uint32 PurgeWowlheimItems(Player* bot, const char* reason);
+    uint32 PurgeWowlheimItemsNow(Player* bot, const char* reason, bool update);
+    const uint32 PURGE_INTERVAL_MS = 30 * 1000;
+}
