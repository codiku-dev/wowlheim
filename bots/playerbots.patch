diff --git a/playerbot/PlayerbotLLMInterface.cpp b/playerbot/PlayerbotLLMInterface.cpp
index 311b372..6194874 100644
--- a/playerbot/PlayerbotLLMInterface.cpp
+++ b/playerbot/PlayerbotLLMInterface.cpp
@@ -662,6 +662,87 @@ std::string PlayerbotLLMInterface::Generate(const std::string& prompt, int timeO
     return response;
 }
 
+// Wowlheim : petite requete HTTP vers le pont local (route /intent). Pas de TLS ni d'hote distant :
+// la cle de l'API d'intention reste dans le pont Python, mangosd ne parle qu'a 127.0.0.1.
+std::string PlayerbotLLMInterface::WowlheimPostLocal(const std::string& path, const std::string& body, int timeOutSeconds)
+{
+    ParsedUrl parsedUrl = sPlayerbotAIConfig.llmEndPointUrl;
+    if (parsedUrl.https || (parsedUrl.hostname != "127.0.0.1" && parsedUrl.hostname != "localhost"))
+        return "";
+
+#ifdef _WIN32
+    WSADATA wsaData;
+    if (WSAStartup(MAKEWORD(2, 2), &wsaData) != 0)
+        return "";
+#endif
+
+    struct addrinfo hints = {}, * res = nullptr;
+    hints.ai_family = AF_INET;
+    hints.ai_socktype = SOCK_STREAM;
+    std::string portStr = std::to_string(parsedUrl.port);
+    if (getaddrinfo(parsedUrl.hostname.c_str(), portStr.c_str(), &hints, &res) != 0 || !res)
+    {
+#ifdef _WIN32
+        WSACleanup();
+#endif
+        return "";
+    }
+
+    int sock = socket(res->ai_family, res->ai_socktype, res->ai_protocol);
+#ifdef _WIN32
+    bool badSock = sock == INVALID_SOCKET;
+#else
+    bool badSock = sock < 0;
+#endif
+    if (badSock || connect(sock, res->ai_addr, res->ai_addrlen) < 0)
+    {
+        if (!badSock)
+        {
+#ifdef _WIN32
+            closesocket(sock);
+#else
+            close(sock);
+#endif
+        }
+        freeaddrinfo(res);
+#ifdef _WIN32
+        WSACleanup();
+#endif
+        return "";
+    }
+    freeaddrinfo(res);
+
+    std::ostringstream request;
+    request << "POST " << path << " HTTP/1.1\r\n";
+    request << "Host: " << parsedUrl.hostname << "\r\n";
+    request << "Content-Type: application/json\r\n";
+    request << "Accept: application/json\r\n";
+    request << "Connection: close\r\n";
+    request << "Content-Length: " << body.size() << "\r\n\r\n";
+    request << body;
+    std::string requestStr = request.str();
+
+    std::string response;
+    if (send(sock, requestStr.c_str(), (int)requestStr.size(), 0) >= 0)
+    {
+        int bytesRead = 0;
+        response = RecvWithTimeout(sock, timeOutSeconds, bytesRead);
+    }
+
+#ifdef _WIN32
+    closesocket(sock);
+    WSACleanup();
+#else
+    close(sock);
+#endif
+
+    // Seulement une reponse 200 complete (en-tetes + corps).
+    size_t pos = response.find("\r\n\r\n");
+    if (pos == std::string::npos || response.size() < 12 || response.compare(0, 5, "HTTP/") != 0 || response.compare(9, 3, "200") != 0)
+        return "";
+    return response.substr(pos + 4);
+}
