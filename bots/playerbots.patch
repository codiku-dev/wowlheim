+// Wowlheim : bots aleatoires (comptes RNDBOT) : le contenu Valheim n'existe pas pour eux (WowlheimContent.h).
+bool Wowlheim::BotRefusesWowlheimItems(Player* bot)
+{
+    return bot && sRandomPlayerbotMgr.IsRandomBot(bot);
+}
+
+// Wowlheim : retire (supprime) tout objet >= 9 000 000 de l'inventaire d'un bot aleatoire : equipement, sacs et leur
+// contenu, sac a dos, banque et sacs de banque. Silencieux pour le joueur ; trace sLog.outDetail « Wowlheim: ».
+uint32 Wowlheim::PurgeWowlheimItems(Player* bot, const char* reason)
+{
+    if (!BotRefusesWowlheimItems(bot))
+        return 0;
+    return PurgeWowlheimItemsNow(bot, reason, true);
+}
+
+// Wowlheim : meme retrait sans verifier IsRandomBot, pour un bot aleatoire en cours de creation (pas encore enregistre
+// comme bot aleatoire ni dans le monde : update = false, aucun paquet envoye).
+uint32 Wowlheim::PurgeWowlheimItemsNow(Player* bot, const char* reason, bool update)
+{
+    uint32 removed = 0;
+    std::ostringstream entries;
+    auto purge = [&](uint8 bag, uint8 slot)
+    {
+        Item* item = bot->GetItemByPos(bag, slot);
+        if (!item || !item->GetProto() || !IsWowlheimItem(item->GetProto()->ItemId))
+            return;
+        entries << " " << item->GetProto()->ItemId << "x" << item->GetCount();
+        removed += item->GetCount();
+        bot->DestroyItem(bag, slot, update);
+    };
+
+    // contenu des sacs (inventaire puis banque) avant les emplacements eux-memes
+    for (uint8 bagSlot = INVENTORY_SLOT_BAG_START; bagSlot < BANK_SLOT_BAG_END; ++bagSlot)
+    {
+        if (bagSlot >= INVENTORY_SLOT_BAG_END && bagSlot < BANK_SLOT_BAG_START)
+            continue;
+        if (Bag* pBag = (Bag*)bot->GetItemByPos(INVENTORY_SLOT_BAG_0, bagSlot))
+        {
+            if (!pBag->IsBag())
+                continue;
+            for (uint32 j = 0; j < pBag->GetBagSize(); ++j)
+                purge(bagSlot, uint8(j));
+        }
+    }
+
+    // equipement, sacs, sac a dos, banque, sacs de banque
+    for (uint8 slot = EQUIPMENT_SLOT_START; slot < BANK_SLOT_BAG_END; ++slot)
+        purge(INVENTORY_SLOT_BAG_0, slot);
+
+    if (removed)
+        sLog.outDetail("Wowlheim: objets Valheim retires au bot aleatoire %s (%s) :%s", bot->GetName(), reason, entries.str().c_str());
+    return removed;
+}
