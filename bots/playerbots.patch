@@ -25,6 +25,46 @@ namespace ai
         virtual bool Execute(Event& event) override;
     };
 
+    // Wowlheim : rejoindre le maitre (vrai joueur) loin ou dans une instance SANS teleportation (demande de
+    // Robin) : le bot vient a pied par les chemins de playerbots (routes, bateaux, vols). Pour une instance, il
+    // marche jusqu'au portail et le franchit comme un joueur (CMSG_AREATRIGGER, memes controles que le client) ;
+    // sans chemin, il attend a l'entree.
+    class JoinFarMasterAction : public SummonAction
+    {
+    public:
+        JoinFarMasterAction(PlayerbotAI* ai) : SummonAction(ai, "join far master") {}
+        virtual bool Execute(Event& event) override
+        {
+            Player* master = GetMaster();
+            if (!master || master->IsBeingTeleported() || bot->IsBeingTeleported() || bot->IsTaxiFlying())
+                return false;
+
+            if (master->GetMapId() != bot->GetMapId())
+            {
+                AreaTrigger const* at = sObjectMgr.GetMapEntranceTrigger(master->GetMapId());
+                AreaTriggerEntry const* door = at ? sAreaTriggerStore.LookupEntry(at->entry) : nullptr;
+                if (door && door->mapid == bot->GetMapId())
+                {
+                    float reach = std::max(door->radius, 3.0f) + 2.0f;
+                    if (bot->GetDistance(door->x, door->y, door->z) <= reach)
+                    {
+                        sLog.outDetail("Wowlheim: %s franchit le portail %u vers la carte %u (maitre %s)", bot->GetName(), at->entry, at->target_mapId, master->GetName());
+                        std::unique_ptr<WorldPacket> packet(new WorldPacket(CMSG_AREATRIGGER, 4));
+                        *packet << uint32(at->entry);
+                        bot->GetSession()->QueuePacket(std::move(packet));
+                        SetDuration(3000);
+                        return true;
+                    }
+                    sLog.outDetail("Wowlheim: %s marche vers l'entree de l'instance %u (maitre %s)", bot->GetName(), master->GetMapId(), master->GetName());
+                    return MoveTo2(WorldPosition(door->mapid, door->x, door->y, door->z));
+                }
+            }
+
+            sLog.outDetail("Wowlheim: %s rejoint %s a pied", bot->GetName(), master->GetName());
+            return MoveTo2(WorldPosition(master));
+        }
+    };
