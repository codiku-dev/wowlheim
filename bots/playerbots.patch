+#pragma once
+
+// Wowlheim : traduction des ordres francais courts d'un vrai joueur vers les commandes playerbots
+// existantes (« suis-moi » -> follow, « invite-moi » -> invite...). playerbots ne comprend que l'anglais
+// et n'a aucun mecanisme d'alias (ni table SQL ni reglage AiPlayerbot.*).
+// En-tete autonome (bibliotheque standard seulement) : teste hors jeu par bots/tests/test_fr_commands.py.
+// Regle : apres normalisation (minuscules, sans accents, ponctuation -> espace), le message entier doit
+// etre EXACTEMENT une phrase de la table, au nom du bot et a des mots de politesse pres (« stp », « allez »...).
+// « je te suis reconnaissant » ou « attends je reviens » ne declenchent donc rien.
+
+#include <string>
+#include <vector>
+#include <cstddef>
+
+namespace wowlheim
+{
+    struct FrenchCommandEntry
+    {
+        const char* phrase;  // deja normalisee : a-z, 0-9, un espace entre les mots
+        const char* command; // commande playerbots
+    };
+
+    // Wowlheim : table des phrases reconnues. Garder les phrases normalisees (le test le verifie).
+    static const FrenchCommandEntry frenchCommandTable[] =
+    {
+        // suivre
+        { "suis moi", "follow" }, { "suivez moi", "follow" }, { "suis nous", "follow" }, { "suivez nous", "follow" },
+        { "suis", "follow" }, { "suivez", "follow" }, { "follow", "follow" }, { "follow me", "follow" },
+        { "viens avec moi", "follow" }, { "venez avec moi", "follow" }, { "viens avec nous", "follow" }, { "venez avec nous", "follow" },
+        { "on y va", "follow" }, { "on y go", "follow" }, { "go", "follow" }, { "let s go", "follow" }, { "lets go", "follow" },
+        { "on bouge", "follow" }, { "on avance", "follow" }, { "en route", "follow" },
+        { "viens", "follow" }, { "venez", "follow" }, { "viens ici", "follow" }, { "venez ici", "follow" },
+        { "viens la", "follow" }, { "venez la", "follow" }, { "reviens", "follow" }, { "revenez", "follow" },
+        { "reviens ici", "follow" }, { "ramene toi", "follow" }, { "colle moi", "follow" },
+        // rester
+        { "reste", "stay" }, { "restez", "stay" }, { "reste la", "stay" }, { "restez la", "stay" },
+        { "reste ici", "stay" }, { "restez ici", "stay" }, { "reste en place", "stay" },
+        { "attends", "stay" }, { "attendez", "stay" }, { "attends moi", "stay" }, { "attendez moi", "stay" },
+        { "attends moi ici", "stay" }, { "attendez moi ici", "stay" }, { "attends moi la", "stay" }, { "attendez moi la", "stay" },
+        { "attends ici", "stay" }, { "attendez ici", "stay" }, { "attends la", "stay" }, { "attendez la", "stay" },
+        { "bouge pas", "stay" }, { "bougez pas", "stay" }, { "ne bouge pas", "stay" }, { "ne bougez pas", "stay" },
+        { "bouge plus", "stay" }, { "bougez plus", "stay" }, { "pas bouger", "stay" }, { "stay", "stay" },
+        // arreter (s'arreter sur place)
+        { "stop", "stay" }, { "arrete", "stay" }, { "arretez", "stay" }, { "arrete toi", "stay" }, { "arretez vous", "stay" },
+        { "halte", "stay" }, { "on s arrete", "stay" },
+        // attaquer la cible du joueur
+        { "attaque", "attack" }, { "attaquez", "attack" }, { "attaque le", "attack" }, { "attaque la", "attack" },
+        { "attaquez le", "attack" }, { "attaquez la", "attack" }, { "attaque ma cible", "attack" }, { "attaquez ma cible", "attack" },
+        { "on attaque", "attack" }, { "a l attaque", "attack" }, { "attack", "attack" },
+        { "tape", "attack" }, { "tapez", "attack" }, { "tape le", "attack" }, { "tape la", "attack" },
+        { "tapez le", "attack" }, { "tapez la", "attack" }, { "frappe le", "attack" }, { "frappe la", "attack" },
+        { "tue le", "attack" }, { "tue la", "attack" }, { "tuez le", "attack" }, { "tuez la", "attack" },
+        { "focus", "attack" }, { "focus le", "attack" }, { "focus la", "attack" }, { "focus ma cible", "attack" },
+        { "pull", "pull" }, { "pull le", "pull" }, { "pull la", "pull" }, { "pull ca", "pull" },
+        // rejoindre le joueur de loin : il vient a pied (follow), jamais de teleportation (demande de Robin)
+        { "rejoins moi", "follow" }, { "rejoignez moi", "follow" }, { "rejoins nous", "follow" }, { "rejoignez nous", "follow" },
+        { "viens me rejoindre", "follow" }, { "venez me rejoindre", "follow" }, { "viens nous rejoindre", "follow" },
+        { "venez nous rejoindre", "follow" }, { "tp toi", "follow" }, { "teleporte toi", "follow" }, { "summon", "follow" },
+        // ramasser
+        { "loot", "loot" }, { "loote", "loot" }, { "lootez", "loot" }, { "loot tout", "loot" },
+        { "ramasse", "loot" }, { "ramassez", "loot" }, { "ramasse le loot", "loot" }, { "ramassez le loot", "loot" },
+        { "ramasse tout", "loot" }, { "ramassez tout", "loot" }, { "prends le loot", "loot" }, { "prenez le loot", "loot" },
+        { "fouille", "loot" }, { "fouille le", "loot" }, { "fouille les corps", "loot" },
+        // relacher l'esprit / ressusciter (ange)
+        { "release", "release" }, { "relache", "release" }, { "relache ton esprit", "release" }, { "relache l esprit", "release" },
+        { "libere ton esprit", "release" }, { "libere l esprit", "release" }, { "va au cimetiere", "release" },
+        { "ressuscite", "revive" }, { "ressuscite toi", "revive" }, { "ressucite toi", "revive" }, { "resu toi", "revive" },
+        { "rez toi", "revive" }, { "res toi", "revive" }, { "revive", "revive" }, { "va voir l ange", "revive" },
+        // quitter le groupe
+        { "quitte le groupe", "leave" }, { "quittez le groupe", "leave" }, { "quitte le grp", "leave" }, { "quitte grp", "leave" },
+        { "quitte groupe", "leave" }, { "sors du groupe", "leave" }, { "sortez du groupe", "leave" },
+        { "degage du groupe", "leave" }, { "leave", "leave" },
+        // le bot invite le joueur dans son groupe (« inv » = invite en jargon francais, pas l'inventaire)
+        { "invite moi", "invite" }, { "invitez moi", "invite" }, { "inv moi", "invite" }, { "inv", "invite" }, { "invite", "invite" },
+        { "tu peux m inviter", "invite" }, { "tu peux m inv", "invite" }, { "peux tu m inviter", "invite" },
+        { "tu m invites", "invite" }, { "tu m invite", "invite" }, { "tu m inv", "invite" },
+        { "invite moi dans ton groupe", "invite" }, { "tu peux m inviter dans ton groupe", "invite" },
+        { "invite moi dans le groupe", "invite" }, { "inv grp", "invite" }, { "inv groupe", "invite" },
+    };
+
+    // Wowlheim : mots de politesse ou d'appel ignores en debut ou en fin de message.
+    static const char* const frenchCommandFillers[] =
+    {
+        "s il te plait", "s il vous plait", "sil te plait", "sil vous plait", "stp", "svp", "plz", "pls", "please",
+        "merci", "allez y", "vas y", "allez", "aller", "ok", "okay", "bon", "hop", "eh", "hey", "yo", "oh", "alors",
+        "vite", "maintenant", "tout de suite", "les gars", "tout le monde", "go",
+    };
+
+    static const size_t frenchCommandMaxChars = 60; // message plus long : conversation, pas un ordre
+    static const size_t frenchCommandMaxWords = 8;
+
+    // Wowlheim : une lettre latin-1 (ou le 2e octet UTF-8 + 0x40) sans accent ; 0 si ce n'est pas une lettre.
+    inline char FoldLatin1(unsigned char c)
+    {
+        if (c >= 0xC0 && c <= 0xDE && c != 0xD7)
+            c = (unsigned char)(c + 0x20); // majuscule accentuee -> minuscule
+        if (c >= 0xE0 && c <= 0xE6) return 'a';
+        if (c == 0xE7) return 'c';
+        if (c >= 0xE8 && c <= 0xEB) return 'e';
+        if (c >= 0xEC && c <= 0xEF) return 'i';
+        if (c == 0xF1) return 'n';
+        if ((c >= 0xF2 && c <= 0xF6) || c == 0xF8) return 'o';
+        if (c >= 0xF9 && c <= 0xFC) return 'u';
+        if (c == 0xFD || c == 0xFF) return 'y';
+        return 0;
+    }
+
+    // Wowlheim : minuscules, sans accents (UTF-8 ou latin-1), tout autre signe -> espace, espaces fusionnes.
+    inline std::string NormalizeFrench(const std::string& text)
+    {
+        std::string out;
+        out.reserve(text.size());
+        bool space = true;
+        auto put = [&](char ch)
+        {
+            if (ch == ' ')
+            {
+                if (!space)
+                    out += ' ';
+                space = true;
+                return;
+            }
+            out += ch;
+            space = false;
+        };
+
+        for (size_t i = 0; i < text.size(); ++i)
+        {
+            unsigned char c = (unsigned char)text[i];
+            if (c >= 'A' && c <= 'Z')
+                put((char)(c - 'A' + 'a'));
+            else if ((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9'))
+                put((char)c);
+            else if (c < 0x80)
+                put(' ');
+            else if (c == 0xC3 && i + 1 < text.size()) // UTF-8 latin-1 : C3 xx = U+00C0..U+00FF
+            {
+                char f = FoldLatin1((unsigned char)((unsigned char)text[i + 1] + 0x40));
+                put(f ? f : ' ');
+                ++i;
+            }
+            else if (c == 0xC5 && i + 1 < text.size() && ((unsigned char)text[i + 1] == 0x93 || (unsigned char)text[i + 1] == 0x92)) // oe
+            {
+                put('o');
+                put('e');
+                ++i;
+            }
+            else if (c >= 0xC0) // autre sequence UTF-8 (apostrophe typographique, emoji...) : separateur
+            {
+                size_t len = (c >= 0xF0) ? 4 : (c >= 0xE0) ? 3 : 2;
+                bool utf8 = i + len <= text.size();
+                for (size_t k = 1; utf8 && k < len; ++k)
+                    utf8 = ((unsigned char)text[i + k] & 0xC0) == 0x80;
+                if (utf8)
+                {
+                    put(' ');
+                    i += len - 1;
+                }
+                else // octet latin-1 isole
+                {
+                    char f = FoldLatin1(c);
+                    put(f ? f : ' ');
+                }
+            }
+            else
+                put(' ');
+        }
+
+        if (!out.empty() && out.back() == ' ')
+            out.pop_back();
+        return out;
+    }
+
+    inline std::vector<std::string> SplitWords(const std::string& normalized)
+    {
+        std::vector<std::string> words;
+        size_t start = 0;
+        while (start < normalized.size())
+        {
+            size_t end = normalized.find(' ', start);
+            if (end == std::string::npos)
+                end = normalized.size();
+            if (end > start)
+                words.push_back(normalized.substr(start, end - start));
+            start = end + 1;
+        }
+        return words;
+    }
+
+    inline std::string JoinWords(const std::vector<std::string>& words)
+    {
+        std::string out;
+        for (size_t i = 0; i < words.size(); ++i)
+        {
+            if (i)
+                out += ' ';
+            out += words[i];
+        }
+        return out;
+    }
+
+    // Wowlheim : retire une sequence de mots en tete ou en queue (s'il reste au moins un mot). Vrai si retire.
+    inline bool StripWords(std::vector<std::string>& words, const std::vector<std::string>& seq)
+    {
+        if (seq.empty() || words.size() <= seq.size())
+            return false;
+
+        bool head = true, tail = true;
+        for (size_t k = 0; k < seq.size(); ++k)
+        {
+            head = head && words[k] == seq[k];
+            tail = tail && words[words.size() - seq.size() + k] == seq[k];
+        }
+
+        if (head)
+            words.erase(words.begin(), words.begin() + seq.size());
+        else if (tail)
+            words.erase(words.end() - seq.size(), words.end());
+        return head || tail;
+    }
+
+    // Wowlheim : commande playerbots pour un ordre francais court, ou "" si le message n'en est pas un.
+    inline std::string TranslateFrenchCommand(const std::string& text, const std::string& botName)
+    {
+        if (text.empty() || text.size() > frenchCommandMaxChars * 2 || text.find('|') != std::string::npos) // liens d'objets
+            return "";
+
+        std::string normalized = NormalizeFrench(text);
+        if (normalized.empty() || normalized.size() > frenchCommandMaxChars)
+            return "";
+
+        std::vector<std::string> words = SplitWords(normalized);
+        if (words.size() > frenchCommandMaxWords)
+            return "";
+
+        std::vector<std::vector<std::string>> strippable;
+        std::string name = NormalizeFrench(botName);
+        if (!name.empty())
+            strippable.push_back(SplitWords(name));
+        for (const char* filler : frenchCommandFillers)
+            strippable.push_back(SplitWords(filler));
+
+        while (true)
+        {
+            std::string joined = JoinWords(words);
+            for (const FrenchCommandEntry& entry : frenchCommandTable)
+            {
+                if (joined == entry.phrase)
+                    return entry.command;
+            }
+
+            bool stripped = false;
+            for (const std::vector<std::string>& seq : strippable)
+            {
+                if (StripWords(words, seq))
+                {
+                    stripped = true;
+                    break;
+                }
+            }
+
+            if (!stripped)
+                return "";
+        }
+    }
+}
