+// Wowlheim : nombre de requetes /intent en cours pour tout le serveur (borne le nombre de threads).
+static std::atomic<int> wowlheimIntentsInFlight(0);
+static const uint32 wowlheimIntentMaxInFlight = 8;
+static const int wowlheimIntentTimeoutSeconds = 4; // le pont repond en ~0,3 s (Jev borne a 2 s)
+static const time_t wowlheimIntentMaxAge = 6;      // au-dela, l'ordre est perime : on l'oublie
+
+// Wowlheim : commandes que le pont peut renvoyer (meme liste que ALLOWED_COMMANDS dans bots/llm_bridge/intent.py).
+static bool WowlheimIntentCommandAllowed(const std::string& command)
+{
+    static const std::set<std::string> allowed = { "follow", "stay", "attack", "invite", "leave", "trade", "loot", "give leader" }; // Wowlheim : plus de « summon » (pas de teleportation)
+    return allowed.find(command) != allowed.end();
+}
+
+// Wowlheim : lit "command":"..." dans la reponse JSON du pont (valeurs ASCII simples, sans echappement).
+static std::string WowlheimParseIntentCommand(const std::string& body)
+{
+    size_t key = body.find("\"command\"");
+    if (key == std::string::npos)
+        return "";
+    size_t colon = body.find(':', key + 9);
+    if (colon == std::string::npos)
+        return "";
+    size_t start = body.find_first_not_of(" \t\r\n", colon + 1);
+    if (start == std::string::npos || body[start] != '"')
+        return "";
+    size_t end = body.find('"', start + 1);
+    if (end == std::string::npos || end - start - 1 > 32)
+        return "";
+    std::string command = body.substr(start + 1, end - start - 1);
+    return WowlheimIntentCommandAllowed(command) ? command : "";
+}
+
+// Wowlheim : appele depuis HandleCommand (thread du joueur qui parle). Ne fait que noter le message ;
+// la requete part du thread du bot (WowlheimHandleIntents), qui seul touche a ses objets d'IA.
+bool PlayerbotAI::WowlheimRequestIntent(uint32 type, const std::string& text, Player& fromPlayer)
+{
+    if (sPlayerbotAIConfig.llmEnabled <= 0 || &fromPlayer == bot || !fromPlayer.isRealPlayer())
+        return false;
+
+    bool whisper = type == CHAT_MSG_WHISPER;
+    bool party = type == CHAT_MSG_PARTY || type == CHAT_MSG_RAID || type == CHAT_MSG_RAID_LEADER;
+    if (!whisper && !party)
+        return false;
+
+    // Messages trop longs, liens d'objets, commandes MJ ou playerbots explicites : pas d'intention.
+    if (text.empty() || text.size() > 255 || text.find('|') != std::string::npos || text.find("::") != std::string::npos)
+        return false;
+    if (text[0] == '.' || text[0] == '!' || text[0] == '#' || text[0] == '@')
+        return false;
+    if (!sPlayerbotAIConfig.commandPrefix.empty() ||
+        (!sPlayerbotAIConfig.commandSeparator.empty() && text.find(sPlayerbotAIConfig.commandSeparator) != std::string::npos))
+        return false;
+
+    // Un inconnu est ecoute seulement en chuchotement (il ne pourra obtenir qu'une invitation).
+    if (party && !bot->IsInGroup(&fromPlayer) && GetMaster() != &fromPlayer)
+        return false;
+
+    std::lock_guard<std::mutex> guard(wowlheimIntentsMutex);
+    if (wowlheimIntents.size() >= 2) // un joueur qui enchaine les phrases : on ne garde que les deux premieres
+        return false;
+
+    WowlheimPendingIntent pending;
+    pending.text = text;
+    pending.from = fromPlayer.GetObjectGuid();
+    pending.type = type;
+    pending.deadline = time(0) + wowlheimIntentMaxAge;
+    wowlheimIntents.push_back(pending);
+    return true;
+}
+
+// Wowlheim : thread du bot (UpdateAI, a chaque tick). Lance les requetes /intent dans un thread detache
+// (jamais d'attente ici), puis execute les commandes revenues comme si le joueur les avait tapees.
+void PlayerbotAI::WowlheimHandleIntents()
+{
+    std::vector<WowlheimPendingIntent> toLaunch, ready;
+    {
+        std::lock_guard<std::mutex> guard(wowlheimIntentsMutex);
+        if (wowlheimIntents.empty())
+            return;
+
+        time_t now = time(0);
+        for (auto it = wowlheimIntents.begin(); it != wowlheimIntents.end();)
+        {
+            if (!it->result)
+            {
+                toLaunch.push_back(*it);
+                it = wowlheimIntents.erase(it);
+                continue;
+            }
+
+            bool done;
+            {
+                std::lock_guard<std::mutex> resultGuard(it->result->lock);
+                done = it->result->done;
+            }
+
+            if (done)
+            {
+                ready.push_back(*it);
+                it = wowlheimIntents.erase(it);
+            }
+            else if (now > it->deadline)
+            {
+                sLog.outDetail("Wowlheim: %s intent timeout", bot->GetName());
+                it = wowlheimIntents.erase(it);
+            }
+            else
+                ++it;
+        }
+    }
+
+    for (WowlheimPendingIntent& pending : toLaunch)
+    {
+        Player* from = sObjectAccessor.FindPlayer(pending.from);
+        if (!from || !from->IsInWorld())
+            continue;
+
+        // Deja une commande anglaise de playerbots (« follow me », « stats »...) : rien a deviner.
+        std::string lower = boost::algorithm::to_lower_copy(boost::algorithm::trim_copy(pending.text));
+        std::string first = lower.substr(0, lower.find(' '));
+        if (lower.empty() || noReplyMsgs.find(lower) != noReplyMsgs.end() ||
+            std::any_of(noReplyMsgStarts.begin(), noReplyMsgStarts.end(), [&lower](const std::string& start) { return lower.find(start) == 0; }) ||
+            aiObjectContext->GetTrigger(lower) || (first.size() >= 4 && aiObjectContext->GetTrigger(first)))
+            continue;
+
+        std::string relation;
+        if (bot->IsInGroup(from))
+            relation = "groupe";
+        else if (GetMaster() == from)
+            relation = "maitre";
+        else if (pending.type == CHAT_MSG_WHISPER)
+            relation = "inconnu";
+        else
+            continue;
+
+        if (wowlheimIntentsInFlight.load() >= (int)wowlheimIntentMaxInFlight)
+            continue;
+
+        std::string body = "{\"bot\":\"" + PlayerbotLLMInterface::SanitizeForJson(bot->GetName()) +
+            "\",\"other\":\"" + PlayerbotLLMInterface::SanitizeForJson(from->GetName()) +
+            "\",\"channel\":\"" + (pending.type == CHAT_MSG_WHISPER ? "whisper" : "party") +
+            "\",\"relation\":\"" + relation +
+            "\",\"message\":\"" + PlayerbotLLMInterface::SanitizeForJson(pending.text) + "\"}";
+
+        std::shared_ptr<WowlheimIntentResult> result = std::make_shared<WowlheimIntentResult>();
+        pending.result = result;
+        pending.deadline = time(0) + wowlheimIntentMaxAge;
+
+        // Thread reseau : ne touche a aucun objet du jeu, seulement a 'result' (partage, survit au bot).
+        ++wowlheimIntentsInFlight;
+        try
+        {
+            std::thread([result, body]()
+            {
+                std::string command = WowlheimParseIntentCommand(PlayerbotLLMInterface::WowlheimPostLocal("/intent", body, wowlheimIntentTimeoutSeconds));
+                {
+                    std::lock_guard<std::mutex> resultGuard(result->lock);
+                    result->command = command;
+                    result->done = true;
+                }
+                --wowlheimIntentsInFlight;
+            }).detach();
+        }
+        catch (...)
+        {
+            --wowlheimIntentsInFlight;
+            continue;
+        }
+
+        std::lock_guard<std::mutex> guard(wowlheimIntentsMutex);
+        wowlheimIntents.push_back(pending);
+    }
+
+    for (WowlheimPendingIntent& pending : ready)
+    {
+        std::string command;
+        {
+            std::lock_guard<std::mutex> resultGuard(pending.result->lock);
+            command = pending.result->command;
+        }
+        if (command.empty())
+            continue;
+
+        Player* from = sObjectAccessor.FindPlayer(pending.from);
+        if (!from || !from->IsInWorld() || from == bot || !from->isRealPlayer())
+            continue;
+
+        // Memes droits que pour un ordre francais exact : maitre ou groupe ; un inconnu, une invitation.
+        bool isMine = GetMaster() == from || bot->IsInGroup(from);
+        if (!isMine && !(pending.type == CHAT_MSG_WHISPER && command == "invite"))
+            continue;
+
+        // En combat, seul l'ordre tactique « attack » passe.
+        if (bot->IsInCombat() && command != "attack")
+        {
+            sLog.outDetail("Wowlheim: %s intent '%s' ignored (combat)", bot->GetName(), command.c_str());
+            continue;
+        }
+
+        // Le LLM repond deja au message : pas d'accuse de reception tout fait en anglais.
+        bool isAiChat = sPlayerbotAIConfig.llmEnabled > 0 && (HasStrategy("ai chat", BotState::BOT_STATE_NON_COMBAT) || sPlayerbotAIConfig.llmEnabled == 3);
+        if (isAiChat)
+            wowlheimQuietTellsUntil = time(0) + 5;
+
+        sLog.outDetail("Wowlheim: %s -> intent '%s' (from %s)", bot->GetName(), command.c_str(), from->GetName());
+        wowlheimIntentReplay = true;
+        HandleCommand(pending.type, command, *from);
+        wowlheimIntentReplay = false;
+        ResetAIInternalUpdateDelay(); // Wowlheim : l'ordre est execute au tick suivant, pas au prochain tour d'IA
+    }
+}
+
+// Wowlheim : phrases d'initiative en groupe (route /spontaneous du pont). Un bot groupe avec un vrai joueur
+// parle parfois de lui-meme : long silence, niveau gagne, mort, elite ou rare tue, nouvelle zone, donjon.
+// Le pont choisit la phrase (personnalite) et gere les recharges (4 min par bot, 30 s pour tout le serveur).
+static std::atomic<int> wowlheimSpontInFlight(0);
+static const int wowlheimSpontMaxInFlight = 3;
+static const int wowlheimSpontTimeoutSeconds = 45;   // file du LLM (15 s max) + generation
+static const uint32 wowlheimSpontMsPerChar = 50;     // delai de frappe (avant : 150 ms, 9 s pour 60 caracteres)
+static const uint32 wowlheimSpontMaxTypingMs = 3000; // plafond du delai de frappe
+
+// Wowlheim : etat partage par groupe (tous les bots du groupe, sur des threads de carte differents).
+struct WowlheimSpontGroupState
+{
+    time_t lastChat = 0;                     // dernier message de groupe vu (bot ou joueur)
+    std::map<std::string, time_t> claims;    // evenement de groupe -> heure : le premier bot qui le prend parle
+};
+static std::mutex wowlheimSpontGroupsMutex;
+static std::map<uint32, WowlheimSpontGroupState> wowlheimSpontGroups;
+
+void PlayerbotAI::WowlheimNoteGroupChat(uint32 groupId)
+{
+    if (!groupId)
+        return;
+    std::lock_guard<std::mutex> guard(wowlheimSpontGroupsMutex);
+    wowlheimSpontGroups[groupId].lastChat = time(0);
+}
+
+// Wowlheim : un seul bot du groupe parle pour un meme evenement de groupe. 'key' identifie l'evenement,
+// 'minInterval' empeche de le reprendre trop tot (meme zone, autre elite...).
+static bool WowlheimClaimGroupEvent(uint32 groupId, const std::string& key, time_t minInterval)
+{
+    time_t now = time(0);
+    std::lock_guard<std::mutex> guard(wowlheimSpontGroupsMutex);
+    WowlheimSpontGroupState& state = wowlheimSpontGroups[groupId];
+    for (auto it = state.claims.begin(); it != state.claims.end();)
+    {
+        if (now - it->second > 3600)
+            it = state.claims.erase(it);
+        else
+            ++it;
+    }
+    auto found = state.claims.find(key);
+    if (found != state.claims.end() && now - found->second < minInterval)
+        return false;
+    state.claims[key] = now;
+    return true;
+}
+
+// Wowlheim : silence du groupe depuis au moins 'delay' secondes ? Le bot qui le constate en premier prend
+// l'evenement et relance le compteur pour tout le groupe (meme si le pont n'a finalement rien a dire).
+static bool WowlheimClaimGroupSilence(uint32 groupId, time_t delay)
+{
+    time_t now = time(0);
+    std::lock_guard<std::mutex> guard(wowlheimSpontGroupsMutex);
+    WowlheimSpontGroupState& state = wowlheimSpontGroups[groupId];
+    if (!state.lastChat)
+    {
+        state.lastChat = now; // groupe tout juste vu : le compteur commence maintenant
+        return false;
+    }
+    if (now - state.lastChat < delay)
+        return false;
+    state.lastChat = now;
+    return true;
+}
+
+// Wowlheim : lit "text":"..." dans la reponse JSON du pont (echappements JSON, \uXXXX converti en UTF-8).
+static std::string WowlheimParseSpontaneousText(const std::string& body)
+{
+    size_t key = body.find("\"text\"");
+    if (key == std::string::npos)
+        return "";
+    size_t colon = body.find(':', key + 6);
+    if (colon == std::string::npos)
+        return "";
+    size_t i = body.find_first_not_of(" \t\r\n", colon + 1);
+    if (i == std::string::npos || body[i] != '"')
+        return "";
+
+    std::string out;
+    for (++i; i < body.size() && body[i] != '"'; ++i)
+    {
+        char c = body[i];
+        if (c != '\\')
+        {
+            out += c;
+            continue;
+        }
+        if (++i >= body.size())
+            return "";
+        switch (body[i])
+        {
+        case 'n': case 'r': case 't': out += ' '; break;
+        case 'b': case 'f': break;
+        case 'u':
+        {
+            if (i + 4 >= body.size())
+                return "";
+            uint32 code = 0; // pas de std::stoul : une exception dans le thread reseau arreterait le serveur
+            for (int k = 1; k <= 4; ++k)
+            {
+                char h = body[i + k];
+                code <<= 4;
+                if (h >= '0' && h <= '9') code |= h - '0';
+                else if (h >= 'a' && h <= 'f') code |= h - 'a' + 10;
+                else if (h >= 'A' && h <= 'F') code |= h - 'A' + 10;
+                else return "";
+            }
+            i += 4;
+            if (code >= 0xD800 && code <= 0xDFFF) // pas d'emoji ni de paire de substitution dans le chat 1.12
+                break;
+            if (code < 0x80)
+                out += (char)code;
+            else if (code < 0x800)
+            {
+                out += (char)(0xC0 | (code >> 6));
+                out += (char)(0x80 | (code & 0x3F));
+            }
+            else
+            {
+                out += (char)(0xE0 | (code >> 12));
+                out += (char)(0x80 | ((code >> 6) & 0x3F));
+                out += (char)(0x80 | (code & 0x3F));
+            }
+            break;
+        }
+        default: out += body[i]; break; // \" \\ \/
+        }
+    }
+    if (i >= body.size())
+        return "";
+    // Une ligne de chat courte ; ni lien ni code de couleur.
+    if (out.size() > 255 || out.find('|') != std::string::npos)
+        return "";
+    return out;
+}
+
+// Wowlheim : le bot est-il dans un groupe (pas de champ de bataille) avec au moins un vrai joueur ?
+// 'other' = ce joueur (le maitre s'il est du groupe). Hors combat ; vivant sauf si 'allowDead' (evenement mort).
+bool PlayerbotAI::WowlheimSpontaneousContext(Player*& other, bool allowDead)
+{
+    other = nullptr;
+    Group* group = bot->GetGroup();
+    if (!group || group->IsBattleGroup() || !bot->IsInWorld() || !bot->GetMap() || bot->GetMap()->IsBattleGround())
+        return false;
+    if (bot->IsInCombat() || (!allowDead && !bot->IsAlive()))
+        return false;
+
+    std::vector<Player*> players = GetPlayersInGroup(); // membres qui ne sont pas des bots
+    Player* master = GetMaster();
+    for (Player* member : players)
+    {
+        if (!member || member == bot || !member->isRealPlayer() || !member->IsInWorld())
+            continue;
+        if (!other || member == master)
+            other = member;
+    }
+    if (!other || other->IsInCombat())
+        return false;
+    return true;
+}
+
+void PlayerbotAI::WowlheimQueueSpontaneous(const std::string& event, time_t delay)
+{
+    // Une seule phrase a la fois ; la mort passe avant un simple silence.
+    if (wowlheimSpontResult || !wowlheimSpontText.empty())
+        return;
+    if (!wowlheimSpontEvent.empty() && !(event == "mort" && wowlheimSpontEvent == "silence"))
+        return;
+    time_t now = time(0);
+    wowlheimSpontEvent = event;
+    wowlheimSpontEventAt = now + delay;
+    wowlheimSpontEventExpire = now + delay + 120; // le moment est passe (combat qui dure, groupe quitte...)
+    sLog.outDetail("Wowlheim: %s spontaneous event '%s'", bot->GetName(), event.c_str());
+}
+
+// Wowlheim : thread du bot (UpdateAI, a chaque tick). Detecte les evenements, lance la requete dans un thread
+// detache (aucun objet du jeu dans ce thread), puis dit la phrase en /groupe apres un delai de frappe.
+void PlayerbotAI::WowlheimHandleSpontaneous()
+{
+    if (!sPlayerbotAIConfig.wowlheimSpontaneousChat || sPlayerbotAIConfig.llmEnabled <= 0 || !bot->IsInWorld() || !bot->GetMap())
+        return;
+
+    // 1. Phrase prete : on l'envoie quand le delai de frappe est ecoule (et pas en plein combat).
+    if (!wowlheimSpontText.empty())
+    {
+        Player* other = nullptr;
+        if (std::chrono::steady_clock::now() >= wowlheimSpontSendAt)
+        {
+            if (WowlheimSpontaneousContext(other, wowlheimSpontTextEvent == "mort"))
+            {
+                sLog.outDetail("Wowlheim: %s spontaneous '%s' -> party: %s", bot->GetName(), wowlheimSpontTextEvent.c_str(), wowlheimSpontText.c_str());
+                SayToParty(wowlheimSpontText, true); // CMSG_MESSAGECHAT de groupe, comme ses autres messages
+                if (bot->GetGroup())
+                    WowlheimNoteGroupChat(bot->GetGroup()->GetId());
+                wowlheimSpontText.clear();
+            }
+            else if (time(0) > wowlheimSpontTextExpire || !bot->GetGroup())
+                wowlheimSpontText.clear();
+        }
+    }
+
+    // 2. Reponse du pont revenue ?
+    if (wowlheimSpontResult)
+    {
+        bool done;
+        std::string text;
+        {
+            std::lock_guard<std::mutex> guard(wowlheimSpontResult->lock);
+            done = wowlheimSpontResult->done;
+            text = wowlheimSpontResult->text;
+        }
+        if (done)
+        {
+            if (!text.empty())
+            {
+                uint32 chars = 0;
+                for (unsigned char c : text)
+                    if ((c & 0xC0) != 0x80)
+                        ++chars;
+                wowlheimSpontText = text;
+                wowlheimSpontTextEvent = wowlheimSpontResultEvent;
+                wowlheimSpontSendAt = std::chrono::steady_clock::now() + std::chrono::milliseconds(std::min(chars * wowlheimSpontMsPerChar, wowlheimSpontMaxTypingMs));
+                wowlheimSpontTextExpire = time(0) + chars * wowlheimSpontMsPerChar / 1000 + 60;
+            }
+            wowlheimSpontResult.reset();
+        }
+        else if (time(0) > wowlheimSpontResultDeadline)
+            wowlheimSpontResult.reset(); // le thread finira seul ; son resultat est ignore
+    }
+
+    // 3. Detection des evenements, une fois par seconde.
+    time_t now = time(0);
+    if (now == wowlheimSpontLastCheck)
+        return;
+    wowlheimSpontLastCheck = now;
+
+    Map* map = bot->GetMap();
+    bool inDungeon = map->IsDungeon() && !map->IsBattleGround();
+    bool dead = !bot->IsAlive();
+    uint32 level = bot->GetLevel();
+    uint32 zone = bot->GetZoneId();
+    Group* group = bot->GetGroup();
+    uint32 groupId = group ? group->GetId() : 0;
+
+    if (!wowlheimSpontInit || groupId != wowlheimSpontGroupId)
+    {
+        // Premier passage ou nouveau groupe : etat de reference, pas d'evenement (pas de « zone » a la connexion).
+        wowlheimSpontInit = true;
+        wowlheimSpontGroupId = groupId;
+        wowlheimSpontLevel = level;
+        wowlheimSpontZone = zone;
+        wowlheimSpontWasDead = dead;
+        wowlheimSpontWasInDungeon = inDungeon;
+        wowlheimSpontElite = ObjectGuid();
+        wowlheimSpontSilenceDelay = 0;
+        wowlheimSpontEvent.clear();
+        return;
+    }
+
+    // Groupe (pas de champ de bataille) avec au moins un vrai joueur ; combat et mort sont verifies a l'envoi.
+    Player* other = nullptr;
+    bool grouped = group && !group->IsBattleGroup() && !map->IsBattleGround() && !GetPlayersInGroup().empty();
+
+    // Niveau gagne (evenement personnel).
+    if (level > wowlheimSpontLevel && grouped)
+        WowlheimQueueSpontaneous("level_up", urand(2, 5));
+    wowlheimSpontLevel = level;
+
+    // Mort : la phrase part quelques secondes apres, en fantome ou sur son corps (« dsl je suis mort »),
+    // comme un joueur qui tape juste apres sa mort ; pas a la resurrection, deja loin de l'evenement.
+    if (dead && !wowlheimSpontWasDead && grouped)
+        WowlheimQueueSpontaneous("mort", urand(3, 8));
+    wowlheimSpontWasDead = dead;
+
+    // Donjon : entree en instance (avant le test de zone, qui change aussi).
+    if (inDungeon && !wowlheimSpontWasInDungeon)
+    {
+        if (grouped && WowlheimClaimGroupEvent(groupId, "donjon:" + std::to_string(bot->GetInstanceId()), 3600))
+            WowlheimQueueSpontaneous("donjon", urand(5, 12));
+    }
+    // Zone : changement de zone (pas de sous-zone), hors instance.
+    else if (zone && zone != wowlheimSpontZone && wowlheimSpontZone && !inDungeon)
+    {
+        if (grouped && WowlheimClaimGroupEvent(groupId, "zone:" + std::to_string(zone), 600))
+            WowlheimQueueSpontaneous("zone", urand(4, 10));
+    }
+    wowlheimSpontZone = zone;
+    wowlheimSpontWasInDungeon = inDungeon;
+
+    // Elite ou rare tue : on surveille la cible courante du bot ; morte = tuee par le groupe.
+    AiObjectContext* context = GetAiObjectContext();
+    ObjectGuid target = AI_VALUE(ObjectGuid, "current target");
+    if (target.IsCreature() && target != wowlheimSpontElite)
+    {
+        Creature* creature = map->GetCreature(target);
+        if (creature && creature->IsAlive() && !creature->IsPet() && creature->GetCreatureInfo()->Rank != CREATURE_ELITE_NORMAL)
+            wowlheimSpontElite = target;
+    }
+    if (!wowlheimSpontElite.IsEmpty())
+    {
+        Creature* creature = map->GetCreature(wowlheimSpontElite);
+        if (!creature)
+            wowlheimSpontElite = ObjectGuid();
+        else if (!creature->IsAlive())
+        {
+            wowlheimSpontElite = ObjectGuid();
+            // Une phrase par groupe et par 3 min au plus (en donjon, chaque groupe de monstres est elite).
+            if (grouped && WowlheimClaimGroupEvent(groupId, "kill_elite", 180))
+                WowlheimQueueSpontaneous("kill_elite", urand(3, 8));
+        }
+    }
+
+    // Silence : aucun message de groupe depuis N minutes (N tire par bot entre Min et Max).
+    if (!wowlheimSpontSilenceDelay)
+        wowlheimSpontSilenceDelay = urand(sPlayerbotAIConfig.wowlheimSpontaneousSilenceMin, sPlayerbotAIConfig.wowlheimSpontaneousSilenceMax);
+    if (grouped && wowlheimSpontEvent.empty() && !wowlheimSpontResult && wowlheimSpontText.empty() &&
+        WowlheimSpontaneousContext(other, false) && WowlheimClaimGroupSilence(groupId, wowlheimSpontSilenceDelay))
+    {
+        wowlheimSpontSilenceDelay = 0; // nouveau tirage pour la prochaine fois
+        WowlheimQueueSpontaneous("silence", 0);
+    }
+
+    // 4. Evenement en attente : envoi au pont quand le moment est bon.
+    if (wowlheimSpontEvent.empty() || wowlheimSpontResult || now < wowlheimSpontEventAt)
+        return;
+    if (now > wowlheimSpontEventExpire)
+    {
+        wowlheimSpontEvent.clear();
+        return;
+    }
+    if (!WowlheimSpontaneousContext(other, wowlheimSpontEvent == "mort") || wowlheimSpontInFlight.load() >= wowlheimSpontMaxInFlight)
+        return; // on reessaie a la seconde suivante (jusqu'a l'expiration)
+
+    std::map<std::string, std::string> fields;
+    ChatReplyAction::GetAIChatPlaceholders(fields, bot, "bot");
+    ChatReplyAction::GetAIChatPlaceholders(fields, other, "other");
+    auto field = [&fields](const std::string& name) { return PlayerbotLLMInterface::SanitizeForJson(fields["<" + name + ">"]); };
+    std::string body = "{\"bot\":\"" + field("bot name") +
+        "\",\"bot_race\":\"" + field("bot race") +
+        "\",\"bot_class\":\"" + field("bot class") +
+        "\",\"bot_level\":\"" + field("bot level") +
+        "\",\"bot_gender\":\"" + field("bot gender") +
+        "\",\"zone\":\"" + field("bot zone") +
+        "\",\"subzone\":\"" + field("bot subzone") +
+        "\",\"other\":\"" + field("other name") +
+        "\",\"other_race\":\"" + field("other race") +
+        "\",\"other_class\":\"" + field("other class") +
+        "\",\"other_level\":\"" + field("other level") +
+        "\",\"channel\":\"in party chat\",\"event\":\"" + wowlheimSpontEvent + "\"}";
+
+    std::shared_ptr<WowlheimSpontaneousResult> result = std::make_shared<WowlheimSpontaneousResult>();
+    ++wowlheimSpontInFlight;
+    try
+    {
+        // Thread reseau : ne touche a aucun objet du jeu, seulement a 'result' (partage, survit au bot).
+        std::thread([result, body]()
+        {
+            std::string text = WowlheimParseSpontaneousText(PlayerbotLLMInterface::WowlheimPostLocal("/spontaneous", body, wowlheimSpontTimeoutSeconds));
+            {
+                std::lock_guard<std::mutex> guard(result->lock);
+                result->text = text;
+                result->done = true;
+            }
+            --wowlheimSpontInFlight;
+        }).detach();
+    }
+    catch (...)
+    {
+        --wowlheimSpontInFlight;
+        wowlheimSpontEvent.clear();
+        return;
+    }
+
+    sLog.outDetail("Wowlheim: %s spontaneous request '%s' (with %s)", bot->GetName(), wowlheimSpontEvent.c_str(), other->GetName());
+    wowlheimSpontResult = result;
+    wowlheimSpontResultEvent = wowlheimSpontEvent;
+    wowlheimSpontResultDeadline = now + wowlheimSpontTimeoutSeconds + 5;
+    wowlheimSpontEvent.clear();
+}
+
+// Wowlheim : conversation avec un vrai joueur. Quand un joueur parle a un bot hors combat (chuchotement, /dire qui
+// lui est adresse, /groupe tout pres), le bot s'arrete, se tourne vers lui et reste sur place jusqu'a 25 s apres le
+// dernier message ou la derniere reponse (plafond 3 min). Combat et ordres passent avant (WowlheimHoldsPosition).
+static const time_t wowlheimTalkLinger = 25;       // fin de la conversation apres ce silence (s)
+static const time_t wowlheimTalkMax = 180;         // plafond d'une conversation (s)
+static const time_t wowlheimTalkRestAfterCap = 60; // apres le plafond, pas de nouvel arret avec ce joueur pendant (s)
+static const float wowlheimTalkPartyRange = 40.0f; // /groupe : seulement si le joueur est tout pres
+static const float wowlheimTalkFaceRange = 40.0f;  // au-dela, il ne se tourne pas vers le joueur
+static const time_t wowlheimCombatChatMaxAge = 60; // message recu en combat : repondu apres, s'il a moins de 60 s
+static const size_t wowlheimCombatChatMax = 3;     // messages mis de cote en combat (le dernier par joueur)
+
+// Wowlheim : dernier bot qui a repondu a chaque joueur, et reponses a signaler a chaque bot (threads de generation).
+struct WowlheimReplyNote
+{
+    uint32 other = 0;  // bot -> joueur ; joueur -> bot
+    time_t shownAt = 0;
+};
+static std::mutex wowlheimRepliesMutex;
+static std::map<uint32, WowlheimReplyNote> wowlheimLastReplier; // joueur -> bot qui lui a repondu en dernier
+static std::map<uint32, WowlheimReplyNote> wowlheimNewReplies;  // bot -> joueur, a lire par le thread du bot
+static std::atomic<int> wowlheimNewRepliesCount(0);
+
+void PlayerbotAI::WowlheimNoteReply(uint32 botLow, uint32 playerLow, uint32 delayMs)
+{
+    time_t shownAt = time(0) + (delayMs + 999) / 1000;
+    std::lock_guard<std::mutex> guard(wowlheimRepliesMutex);
+    wowlheimLastReplier[playerLow] = { botLow, shownAt };
+    if (wowlheimNewReplies.find(botLow) == wowlheimNewReplies.end())
+        ++wowlheimNewRepliesCount;
+    wowlheimNewReplies[botLow] = { playerLow, shownAt };
+}
+
+bool PlayerbotAI::WowlheimHoldsPosition() const
+{
+    return wowlheimTalkUntil && !wowlheimTalkSoft && bot->IsAlive() && !bot->IsInCombat() && time(0) <= wowlheimTalkUntil;
+}
+
+// Wowlheim : le message est-il pour ce bot ? Chuchotement : oui. /groupe : si le joueur est tout pres.
+// /dire : son nom est cite, ou il a repondu au message precedent du joueur, ou c'est le seul bot a portee de dire.
+bool PlayerbotAI::WowlheimChatAddressedToMe(uint32 type, Player* from, const std::string& msg)
+{
+    if (type == CHAT_MSG_WHISPER)
+        return true;
+
+    if (!IsSafe(from) || from->IsBeingTeleported())
+        return false;
+
+    if (type == CHAT_MSG_PARTY || type == CHAT_MSG_RAID || type == CHAT_MSG_RAID_LEADER)
+        return bot->IsInGroup(from) && bot->GetDistance(from) <= wowlheimTalkPartyRange;
+
+    if (type != CHAT_MSG_SAY)
+        return false;
+
+    float sayRange = sWorld.getConfig(CONFIG_FLOAT_LISTEN_RANGE_SAY);
+    if (bot->GetDistance(from) > sayRange)
+        return false;
+
+    std::string lowerMsg = boost::algorithm::to_lower_copy(msg);
+    std::string lowerName = boost::algorithm::to_lower_copy(std::string(bot->GetName()));
+    if (lowerMsg.find(lowerName) != std::string::npos)
+        return true;
+
+    {
+        std::lock_guard<std::mutex> guard(wowlheimRepliesMutex);
+        auto it = wowlheimLastReplier.find(from->GetGUIDLow());
+        if (it != wowlheimLastReplier.end() && time(0) - it->second.shownAt <= wowlheimTalkLinger + 30)
+            return it->second.other == bot->GetGUIDLow();
+    }
+
+    // Wowlheim : comme un vrai joueur, on sait qu'on nous parle si le joueur nous cible.
+    if (from->GetSelectionGuid() == bot->GetObjectGuid())
+        return true;
+
+    // Seul bot a portee de dire du joueur, ou bot le plus proche a moins de 8 m (on parle a celui d'en face) ?
+    std::list<Player*> around;
+    MaNGOS::AnyPlayerInObjectRangeCheck check(from, sayRange);
+    MaNGOS::PlayerListSearcher<MaNGOS::AnyPlayerInObjectRangeCheck> searcher(around, check);
+    Cell::VisitWorldObjects(from, searcher, sayRange);
+    float myDist = bot->GetDistance(from);
+    bool alone = true, nearest = myDist <= 8.0f;
+    for (Player* other : around)
+    {
+        if (other != bot && other != from && other->GetPlayerbotAI() && !other->isRealPlayer())
+        {
+            alone = false;
+            if (other->GetDistance(from) < myDist)
+                nearest = false;
+        }
+    }
+    return alone || nearest;
+}
+
+void PlayerbotAI::WowlheimFace(Player* from)
+{
+    if (!from || !IsSafe(from) || from->IsBeingTeleported() || !bot->IsAlive() || bot->IsInCombat() || bot->IsTaxiFlying())
+        return;
+    if (bot->GetDistance(from) > wowlheimTalkFaceRange || !bot->IsStopped())
+        return;
+    if (bot->HasInArc(from, M_PI_F / 8))
+        return;
+    sServerFacade.SetFacingTo(bot, from, true); // orientation + battement de mouvement : les clients le voient tourner
+}
+
+void PlayerbotAI::WowlheimStartTalk(Player* from, time_t until, const char* why)
+{
+    time_t now = time(0);
+    uint32 fromLow = from->GetGUIDLow();
+    auto rest = wowlheimTalkRest.find(fromLow);
+    if (rest != wowlheimTalkRest.end())
+    {
+        if (now < rest->second)
+            return;
+        wowlheimTalkRest.erase(rest);
+    }
+
+    if (!wowlheimTalkUntil || wowlheimTalkWith != from->GetObjectGuid())
+    {
+        wowlheimTalkWith = from->GetObjectGuid();
+        wowlheimTalkCap = now + wowlheimTalkMax;
+        wowlheimTalkUntil = 0;
+        // Il suit deja ce joueur (son maitre) : on ne casse pas le suivi, il est deja a cote de lui.
+        wowlheimTalkSoft = GetMaster() == from && HasStrategy("follow", BotState::BOT_STATE_NON_COMBAT);
+        sLog.outDetail("Wowlheim: %s s'arrete pour parler avec %s (%s%s)", bot->GetName(), from->GetName(), why, wowlheimTalkSoft ? ", le suit deja" : "");
+    }
+    wowlheimTalkUntil = std::min(std::max(wowlheimTalkUntil, until), wowlheimTalkCap);
+
+    if (!wowlheimTalkSoft && !bot->IsInCombat() && bot->IsAlive() && !bot->IsTaxiFlying() && !bot->IsStopped())
+        StopMoving();
+    WowlheimFace(from);
+    wowlheimTalkFaceAt = now + 2;
+}
+
+void PlayerbotAI::WowlheimEndTalk(const char* why)
+{
+    if (!wowlheimTalkUntil)
+        return;
+    sLog.outDetail("Wowlheim: %s reprend ses activites (%s)", bot->GetName(), why);
+    wowlheimTalkUntil = 0;
+    wowlheimTalkCap = 0;
+    wowlheimTalkSoft = false;
+    wowlheimTalkWith = ObjectGuid();
+    ResetAIInternalUpdateDelay();
+}
+
+// Wowlheim : thread du bot, a chaque tick. Les reponses en attente partent tout de suite vers le pont (avant :
+// au tour d'IA suivant). En combat, le chat d'un vrai joueur est mis de cote et repondu a la fin du combat.
+void PlayerbotAI::WowlheimProcessChat()
+{
+    std::vector<ChatQueuedReply> ready;
+    time_t now = time(0);
+    {
+        std::scoped_lock lock(chatRepliesMutex);
+        if (chatReplies.empty() && wowlheimCombatChats.empty())
+            return;
+
+        std::list<ChatQueuedReply> delayed;
+        while (!chatReplies.empty())
+        {
+            ChatQueuedReply holder = chatReplies.front();
+            chatReplies.pop();
+            if (holder.m_time && now < holder.m_time)
+                delayed.push_back(holder);
+            else
+                ready.push_back(holder);
+        }
+        for (ChatQueuedReply& holder : delayed)
+            chatReplies.push(holder);
+    }
+
+    bool combat = bot->IsInCombat();
+    if (!combat && !wowlheimCombatChats.empty())
+    {
+        for (auto& kept : wowlheimCombatChats)
+        {
+            if (now - kept.second <= wowlheimCombatChatMaxAge)
+            {
+                sLog.outDetail("Wowlheim: %s fin du combat, repond a %s (message de %lds) : %s", bot->GetName(), kept.first.m_name.c_str(), long(now - kept.second), kept.first.m_msg.c_str());
+                ready.push_back(kept.first);
+            }
+            else
+                sLog.outDetail("Wowlheim: %s oublie le message de %s recu en combat (%lds) : %s", bot->GetName(), kept.first.m_name.c_str(), long(now - kept.second), kept.first.m_msg.c_str());
+        }
+        wowlheimCombatChats.clear();
+    }
+
+    for (ChatQueuedReply& holder : ready)
+    {
+        Player* from = sObjectAccessor.FindPlayer(ObjectGuid(HIGHGUID_PLAYER, holder.m_guid1));
+        bool direct = from && from != bot && from->IsInWorld() && from->isRealPlayer() &&
+            (holder.m_type == CHAT_MSG_WHISPER || holder.m_type == CHAT_MSG_SAY || holder.m_type == CHAT_MSG_PARTY ||
+             holder.m_type == CHAT_MSG_RAID || holder.m_type == CHAT_MSG_RAID_LEADER);
+
+        if (direct && combat && sPlayerbotAIConfig.llmEnabled > 0)
+        {
+            // Un /dire qui ne lui est pas adresse reste ignore en combat, comme avant.
+            if (holder.m_type == CHAT_MSG_SAY && !WowlheimChatAddressedToMe(holder.m_type, from, holder.m_msg))
+            {
+                sLog.outDetail("Wowlheim: %s en combat, ignore le /dire de %s (pas pour lui)", bot->GetName(), holder.m_name.c_str());
+                continue;
+            }
+            auto same = std::find_if(wowlheimCombatChats.begin(), wowlheimCombatChats.end(),
+                [&holder](const std::pair<ChatQueuedReply, time_t>& kept) { return kept.first.m_guid1 == holder.m_guid1; });
+            if (same != wowlheimCombatChats.end())
+                wowlheimCombatChats.erase(same); // on garde le dernier message de chaque joueur
+            if (wowlheimCombatChats.size() >= wowlheimCombatChatMax)
+                wowlheimCombatChats.erase(wowlheimCombatChats.begin());
+            wowlheimCombatChats.push_back({ holder, now });
+            sLog.outDetail("Wowlheim: %s en combat, met de cote le message de %s : %s", bot->GetName(), holder.m_name.c_str(), holder.m_msg.c_str());
+            continue;
+        }
+
+        if (direct && !combat && bot->IsAlive() && WowlheimChatAddressedToMe(holder.m_type, from, holder.m_msg))
+            WowlheimStartTalk(from, now + wowlheimTalkLinger, "message");
+
+        ChatReplyAction::ChatReplyDo(bot, holder.m_type, holder.m_guid1, holder.m_guid2, holder.m_msg, holder.m_chanName, holder.m_name);
+    }
+}
+
+// Wowlheim : thread du bot, a chaque tick. Reponses envoyees (prolongent la conversation), fin, maintien sur place.
+void PlayerbotAI::WowlheimUpdateTalk()
+{
+    if (wowlheimTalkEndRequest.exchange(false))
+        WowlheimEndTalk("ordre");
+
+    if (wowlheimNewRepliesCount.load() > 0)
+    {
+        WowlheimReplyNote note;
+        {
+            std::lock_guard<std::mutex> guard(wowlheimRepliesMutex);
+            auto it = wowlheimNewReplies.find(bot->GetGUIDLow());
+            if (it != wowlheimNewReplies.end())
+            {
+                note = it->second;
+                wowlheimNewReplies.erase(it);
+                --wowlheimNewRepliesCount;
+            }
+        }
+        if (note.other && !bot->IsInCombat() && bot->IsAlive())
+        {
+            Player* to = sObjectAccessor.FindPlayer(ObjectGuid(HIGHGUID_PLAYER, note.other));
+            if (to && to->IsInWorld() && to->isRealPlayer() && (to->GetObjectGuid() == wowlheimTalkWith || !wowlheimTalkUntil))
+                WowlheimStartTalk(to, note.shownAt + wowlheimTalkLinger, "reponse");
+        }
+    }
+
+    if (!wowlheimTalkUntil)
+        return;
+
+    time_t now = time(0);
+    if (now >= wowlheimTalkCap)
+    {
+        wowlheimTalkRest[wowlheimTalkWith.GetCounter()] = now + wowlheimTalkRestAfterCap;
+        WowlheimEndTalk("plafond de 3 min");
+        return;
+    }
+    if (now > wowlheimTalkUntil)
+    {
+        WowlheimEndTalk("silence");
+        return;
+    }
+
+    Player* with = sObjectAccessor.FindPlayer(wowlheimTalkWith);
+    if (!with || !with->IsInWorld())
+    {
+        WowlheimEndTalk("joueur parti");
+        return;
+    }
+
+    if (wowlheimTalkSoft || bot->IsInCombat() || !bot->IsAlive())
+        return;
+
+    // Quelque chose l'a remis en route (deplacement deja lance, reaction) : il reste sur place.
+    if (!bot->IsStopped() && !IsJumping() && !bot->IsTaxiFlying() && !bot->IsBeingTeleported() &&
+        !bot->HasFlag(UNIT_FIELD_FLAGS, UNIT_FLAG_FLEEING) && !bot->HasFlag(UNIT_FIELD_FLAGS, UNIT_FLAG_CONFUSED))
+        StopMoving();
+
+    if (now >= wowlheimTalkFaceAt)
+    {
+        WowlheimFace(with);
+        wowlheimTalkFaceAt = now + 2;
+    }
+}
+
 void PlayerbotAI::HandleCommand(uint32 type, const std::string& text, Player& fromPlayer, const uint32 lang)
 {
     std::string filtered = text;
 
+    // Wowlheim : ordre court en francais d'un vrai joueur (chuchotement ou groupe, jamais /dire ni canaux)
+    // -> commande playerbots. Seulement de son maitre ou d'un membre de son groupe ; un inconnu peut
+    // seulement demander une invitation en chuchotant. La reponse en texte reste celle du LLM, qui lit
+    // le message brut (SMSG_MESSAGECHAT -> ChatReplyDo) ; l'accuse de reception tout fait est retenu.
+    if (lang != LANG_ADDON && &fromPlayer != bot && fromPlayer.isRealPlayer() &&
+        (type == CHAT_MSG_WHISPER || type == CHAT_MSG_PARTY || type == CHAT_MSG_RAID || type == CHAT_MSG_RAID_LEADER))
+    {
+        std::string command = wowlheim::TranslateFrenchCommand(text, bot->GetName());
+        bool isMine = GetMaster() == &fromPlayer || bot->IsInGroup(&fromPlayer);
+        if (!command.empty() && (isMine || (type == CHAT_MSG_WHISPER && command == "invite")))
+        {
+            bool isAiChat = sPlayerbotAIConfig.llmEnabled > 0 && (HasStrategy("ai chat", BotState::BOT_STATE_NON_COMBAT) || sPlayerbotAIConfig.llmEnabled == 3);
+            if (isAiChat && noReplyMsgs.find(text) == noReplyMsgs.end())
+                wowlheimQuietTellsUntil = time(0) + 5;
+
+            sLog.outDetail("Wowlheim: %s -> '%s' (from %s)", bot->GetName(), command.c_str(), fromPlayer.GetName());
+            filtered = command;
+        }
+        // Wowlheim : pas un ordre francais exact -> phrase libre (« tu viens on va aux mortemines ? ») :
+        // le pont en devine l'intention en asynchrone (WowlheimHandleIntents). Le texte brut suit son
+        // chemin habituel ci-dessous, sans changement.
+        else if (command.empty() && !wowlheimIntentReplay)
+            WowlheimRequestIntent(type, text, fromPlayer);
+    }
+
+    // Wowlheim : un ordre de deplacement (suis-moi, reste la, invocation, attaque...) d'un vrai joueur termine
+    // l'arret pour converser (ordre francais traduit, intention rejouee ou commande anglaise).
+    if (&fromPlayer != bot && fromPlayer.isRealPlayer() && lang != LANG_ADDON)
+    {
+        static const std::set<std::string> wowlheimMoveOrders = { "follow", "stay", "summon", "attack", "flee", "grind",
+            "wander", "guard", "leave", "release", "revive" };
+        std::string first = filtered.substr(0, filtered.find(' '));
+        if (wowlheimMoveOrders.find(first) != wowlheimMoveOrders.end())
+            wowlheimTalkEndRequest = true;
+    }
+
     if (!IsAllowedCommand(filtered) && !GetSecurity()->CheckLevelFor(PlayerbotSecurityLevel::PLAYERBOT_SECURITY_INVITE, type != CHAT_MSG_WHISPER, &fromPlayer))
         return;
 
