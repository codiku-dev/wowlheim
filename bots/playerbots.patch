diff --git a/playerbot/strategy/triggers/RangeTriggers.h b/playerbot/strategy/triggers/RangeTriggers.h
index f320eee..7f5b85e 100644
--- a/playerbot/strategy/triggers/RangeTriggers.h
+++ b/playerbot/strategy/triggers/RangeTriggers.h
@@ -308,6 +308,49 @@ namespace ai
         float distance;
     };
 
+    // Wowlheim : the real-player master of our group is on another map (instance) or more than
+    // 500 yd away. Fires once the master has been far for 10 s and the bot is alive and out of combat
+    // (so the bot appears to "arrive" rather than vanish instantly), then retried every 10 s.
+    class MasterFarAwayTrigger : public Trigger
+    {
+    public:
+        MasterFarAwayTrigger(PlayerbotAI* ai) : Trigger(ai, "master far away", 2), farSince(0) {}
+
+        virtual bool IsActive() override
+        {
+            Player* master = ai->GetMaster();
+            // Where the master is (and his own state): this is what the 10 s delay measures.
+            bool masterFar = master && ai->HasRealPlayerMaster() && master != bot && master->IsInWorld() &&
+                bot->GetGroup() && bot->GetGroup() == master->GetGroup() &&
+                !master->IsBeingTeleported() && sServerFacade.IsAlive(master) &&
+                !master->IsTaxiFlying() && !master->InBattleGround() && !bot->InBattleGround() &&
+                (bot->GetMapId() != master->GetMapId() || bot->GetInstanceId() != master->GetInstanceId() || !bot->IsWithinDist(master, 500.0f, false));
+
+            if (!masterFar)
+            {
+                farSince = 0;
+                return false;
+            }
+
+            time_t now = time(0);
+            if (!farSince)
+                farSince = now;
+
+            // The bot's own transient state only postpones the jump: it must NOT restart the 10 s
+            // delay, or a bot grinding mobs (random bot strategies "grind"/"rpg" stay active in a
+            // player group) re-enters combat every few seconds and never joins its master.
+            if (now - farSince < 10 || bot->IsBeingTeleported() || !sServerFacade.IsAlive(bot) ||
+                sServerFacade.IsInCombat(bot) || bot->IsTaxiFlying())
+                return false;
+
+            farSince = now;
+            return true;
+        }
+
+    private:
+        time_t farSince;
+    };
